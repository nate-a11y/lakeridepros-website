# =============================================================================
# Sanity CMS Configuration (replaces Payload CMS)
# =============================================================================
# Get these from: https://sanity.io/manage → Project Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01

# Sanity API Tokens — generate at: sanity.io/manage → API → Tokens
SANITY_API_READ_TOKEN=your-read-token
SANITY_API_WRITE_TOKEN=your-write-token

# Sanity Webhook Secret — set when creating webhook at: sanity.io/manage → API → Webhooks
SANITY_WEBHOOK_SECRET=your-webhook-secret

# Driver Profile Sync Secret — shared between Supabase webhook and this app
# Generate with: openssl rand -hex 32
DRIVER_SYNC_SECRET=your-driver-sync-secret

# Email Configuration
EMAIL_FROM_NAME=Lake Ride Pros
EMAIL_FROM=contactus@updates.lakeridepros.com

# Supabase Storage (kept during migration for legacy media URLs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Reviews Sync (via Outscraper + Supabase Edge Function)
# Get your Place ID from: https://outscraper.com/google-place-id-finder/
# Or from Google Maps: search your business, copy place_id from URL
GOOGLE_PLACE_ID=ChIJJ8GI2fuCGWIRW8RfPECoxN4

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Lake Ride Pros

# Email Configuration
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=contactus@lakeridepros.com

# Moovs Booking Configuration
NEXT_PUBLIC_MOOVS_EMBED_URL=

# Chargebee Insider billing sync
# Use the Chargebee site subdomain only (for example: lakeridepros).
CHARGEBEE_SITE=
# Full-access, server-only key. Required for authoritative subscription sync
# and authenticated pricing-page sessions. Never prefix with NEXT_PUBLIC.
CHARGEBEE_API_KEY=
# Configure the Chargebee webhook with the same Basic Auth credentials.
CHARGEBEE_WEBHOOK_USERNAME=
CHARGEBEE_WEBHOOK_PASSWORD=
# Non-secret ID of the canonical Insider webhook endpoint.
CHARGEBEE_INSIDER_WEBHOOK_ID=whv2_AzqXEAVQpEZ8kBQs
# Controls whether relevant Chargebee webhook events are rejected, validated
# without writes, or queued for subscription sync. Valid: off, dry-run, apply.
# Keep off until the Insider database migration and deployment are approved.
INSIDERS_CHARGEBEE_SYNC_MODE=off
# Controls the public custom plan buttons and new-member hosted checkout.
# Valid: off, live. Keep off in deployments until the release is approved.
INSIDERS_CHARGEBEE_CHECKOUT_MODE=off
# Separately controls authenticated plan changes and the Chargebee billing
# portal handoff. Valid: off, live. Defaults to off when unset or invalid.
INSIDERS_CHARGEBEE_MANAGEMENT_MODE=off
# Product Catalog 2.0 item price IDs from the approved pricing table.
CHARGEBEE_INSIDER_INDIVIDUAL_MONTHLY_PRICE_ID=
CHARGEBEE_INSIDER_INDIVIDUAL_ANNUAL_PRICE_ID=
CHARGEBEE_INSIDER_FAMILY_MONTHLY_PRICE_ID=
CHARGEBEE_INSIDER_FAMILY_ANNUAL_PRICE_ID=
CHARGEBEE_INSIDER_BUSINESS_MONTHLY_PRICE_ID=
CHARGEBEE_INSIDER_BUSINESS_ANNUAL_PRICE_ID=
# Growth pricing table ID retained for authenticated member plan changes.
CHARGEBEE_INSIDER_PRICING_TABLE_KEY=GPK2OxIlzp

# Internal-only Insider preview data. Demo mode is always denied on a Vercel
# production deployment. The second flag permits a production build started
# specifically for Playwright or a private internal preview.
INSIDERS_DEMO_MODE=false
INSIDERS_INTERNAL_PREVIEW_MODE=false

# Daily Insider reward reconciliation. Keep off until the Insider database
# migration has been approved and applied. Valid modes: off, dry-run, apply.
INSIDERS_REWARDS_RECONCILIATION_MODE=off
INSIDERS_REWARDS_RECONCILIATION_MAX_AWARDS=250
INSIDERS_REWARDS_RECONCILIATION_MAX_LAUNCH_BONUS_CHANGES=250

# Monthly in-account recap generation. Database program settings must also be
# enabled; external delivery remains independently gated below.
INSIDERS_MONTHLY_RECAP_MODE=off
INSIDERS_MONTHLY_RECAP_MAX_RECIPIENTS=500

# Insider member notifications. Keep delivery off until the release candidate
# is approved. Valid modes: off, dry-run, send.
INSIDERS_NOTIFICATION_DELIVERY_MODE=off
INSIDERS_NOTIFICATION_BATCH_SIZE=50
# Keep false until the Twilio number's inbound STOP/opt-out handling has been
# verified for this member program.
INSIDERS_SMS_DELIVERY_ENABLED=false
INSIDERS_EMAIL_FROM="Lake Ride Pros Insider Rewards <contactus@updates.lakeridepros.com>"
# Secure, expiring personalized welcome links. Generate a long random value;
# never expose it to the browser or commit it to Git.
INSIDERS_WELCOME_LINK_SECRET=
# New-member welcome delivery is separate from general notifications.
# Valid: off or send. Keep off until the proof email is approved.
INSIDERS_WELCOME_EMAIL_MODE=off
# Use the same VAPID public key configured for LRP Bolt's send-web-push function.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Printify Configuration (for print-on-demand fulfillment)
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# HMAC secret used to validate X-Pfy-Signature on Printify webhooks
PRINTIFY_WEBHOOK_SECRET=

# Inngest Configuration (for background jobs)
# Get these from your Inngest dashboard: https://app.inngest.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Claude AI Configuration (for SEO content generation)
# Get your API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Cloudflare Turnstile Configuration (for bot protection on forms)
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Bridal Show Admin Configuration
# Set a password for accessing the bridal show admin page
# Access admin at: /bridal-show-admin (password required)
BRIDAL_SHOW_ADMIN_PASSWORD=

# Vercel Cron Secret (automatically set by Vercel, or generate with: openssl rand -hex 32)
CRON_SECRET=
