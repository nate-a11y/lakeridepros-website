{
  "name": "lakeridepros-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=true next dev --webpack",
    "build": "next build",
    "prebuild:full": "npm run lint:colors",
    "build:full": "npm run prebuild:full && npm run build",
    "start": "next start",
    "lint": "eslint",
    "lint:insiders-copy": "node scripts/audit-insiders-customer-language.mjs",
    "lint:insiders-spec": "node scripts/audit-insiders-approved-spec.mjs",
    "audit:insiders-chargebee": "node scripts/audit-insiders-chargebee.mjs",
    "audit:insiders-chargebee-growth": "node scripts/audit-insiders-chargebee-growth.mjs",
    "audit:insiders-chargebee-all": "npm run audit:insiders-chargebee && npm run audit:insiders-chargebee-growth",
    "bootstrap:insiders-chargebee": "tsx scripts/bootstrap-insiders-chargebee.ts",
    "send:insiders-welcome-poc": "tsx scripts/send-insider-welcome-poc.ts",
    "fix:insiders-chargebee": "node scripts/fix-insiders-chargebee.mjs",
    "lint:colors": "node scripts/audit-colors.js",
    "lint:a11y": "eslint --no-warn-ignored . --max-warnings=0",
    "lint:all": "npm run lint && npm run lint:colors && npm run lint:insiders-copy && npm run lint:insiders-spec",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:insiders": "playwright test e2e/insiders.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:a11y:full": "playwright test e2e/accessibility.spec.ts --grep 'full audit' --no-deps",
    "gbp:sync:dry-run": "node scripts/facebook-to-gbp.mjs --dry-run",
    "gbp:sync:publish": "node scripts/facebook-to-gbp.mjs --publish",
    "gbp:sync:install": "bash scripts/install-facebook-to-gbp-launchd.sh",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:insiders": "vitest run 'app/(site)/insider-membership-benefits/__tests__/InsiderPlanSelector.test.tsx' 'app/(site)/insiders/auth/callback/__tests__/route.test.ts' 'app/(site)/insiders/(portal)/account/__tests__/billing-controls.test.tsx' lib/insiders/__tests__/demo-mode.test.ts lib/insiders/__tests__/reconciliation.test.ts lib/insiders/__tests__/monthly-recap.test.ts lib/insiders/__tests__/notification-delivery.test.ts lib/insiders/__tests__/welcome-link.test.ts lib/insiders/__tests__/welcome.test.ts lib/chargebee/__tests__/insider-sync.test.ts lib/chargebee/__tests__/insider-bootstrap.test.ts lib/chargebee/__tests__/management-mode.test.ts lib/chargebee/__tests__/pricing-page.test.ts lib/chargebee/__tests__/checkout.test.ts app/api/chargebee/webhook/__tests__/route.test.ts app/api/insiders/billing/pricing-page/__tests__/route.test.ts app/api/insiders/billing/checkout/__tests__/route.test.ts",
    "test:insiders-chargebee-bootstrap": "vitest run lib/chargebee/__tests__/insider-bootstrap.test.ts",
    "verify:insiders": "npm run lint:a11y && npm run lint:insiders-copy && npm run lint:insiders-spec && npm run test:insiders && npm run test:e2e:insiders",
    "verify": "npm run lint:all && npm run test:run && npm run build"
  },
